<Window x:Class="to_do_list.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:to_do_list"
        mc:Ignorable="d"
        Title="Trening umiejętności nr 2" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>  
            <RowDefinition  Height="36"/>
            <RowDefinition  Height="46"/>
            <RowDefinition  Height="46"/>
            <RowDefinition  Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock 
            Grid.Row="0" 
            Text="To Do List" 
            FontWeight="Bold"
            FontFamily="Courier New"
            FontSize="24" 
            HorizontalAlignment="Center"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            />

        <Border BorderBrush="Black"
        CornerRadius="10"
        Grid.Row="1"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        Height="32"
        Margin="40,5,40,5"
        BorderThickness="2">

            <TextBox x:Name="taskInput"
             BorderThickness="0"
             VerticalAlignment="Center">
                <TextBox.Text>
                    <Binding Path="SomeProperty" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <local:WithoutNumbersInInput/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter Property="ToolTip"
                                    Value="{Binding RelativeSource={RelativeSource Self},
                                Path=(Validation.Errors)[0].ErrorContent}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>

        <Button x:Name="addButton"
        Grid.Row="2"
        Grid.Column="0"
        Content="Dodaj"
        FontSize="20"
        FontWeight="Bold"
        FontFamily="Courier New"
        Click="addButton_Click"
        Width="200"
        Height="39">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="10"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Background="#f0f0f0">
                        <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button 
            x:Name="removeButton"
            Width="200"
            Height="40"
            Grid.Row="2"
            Grid.Column="2"
            Content="Usuń"
            FontSize="20"
            FontWeight="Bold"
            FontFamily="Courier New"
            Click="removeButton_Click"
            >

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="10"
         BorderBrush="Black"
         BorderThickness="1"
         Background="#f0f0f0">
                        <ContentPresenter HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <ListView
            x:Name="taskList"
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            ItemsSource="{Binding Tasks}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="FontFamily" Value="Courier New"/>
                    <Setter Property="FontSize" Value="18"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>



    </Grid>
</Window>
