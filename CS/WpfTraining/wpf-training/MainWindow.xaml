<Window x:Class="wpf_training.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf_training"
        mc:Ignorable="d"
        Title="Trening umiejętności nr 1" Height="360" Width="360">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>




        </Grid.RowDefinitions>
        <TextBlock Text="Ponada wartosc: " VerticalAlignment="Center"  x:Name="podanaWartosc"/>
        <TextBox
            x:Name="inputTekstowy"
            Grid.Row="2"
            Height="32"
            VerticalContentAlignment="Center"
            Padding="8"
            TextChanged="inputTekstowy_TextChanged"
            />
        <TextBox
       x:Name="inputTekstowy_2"
       Grid.Row="4"
       Height="32"
       VerticalContentAlignment="Center"
       Padding="8"
       PreviewTextInput="inputTekstowy_2_PreviewTextInput"
       />
        <Button 
            Grid.Row="6"
            Height="32"
            Content="Pobierz"
            Click="GetInput_Click"
            />
    </Grid>
        
</Window>
