<Page x:Class="WindowsStoreClone.Pages.AppDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WindowsStoreClone.Pages"
      xmlns:uc="clr-namespace:WindowsStoreClone.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppDetails">
    <ScrollViewer
        Name="AppDetailsScrollViewer"
        HorizontalScrollBarVisibility="Hidden"
        VerticalScrollBarVisibility="Hidden"
        Background="#2e2e2e"
        >

        <StackPanel
            Name="AppDetailsPageMainAStackPanel"
            Orientation="Vertical"
            Width="{Binding ElementName=AppDetailsScrollViewer, Path=ActualWidth}"
            Background="#2e2e2e"
            Margin="0,0,0,15"
            >
            <uc:AppDetailsTitleAndBackground x:Name="AppDetailsAndBackground" />
            <Grid
                Name="Tabs"
                >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.15*" />
                    <ColumnDefinition Width="0.7*" />
                    <ColumnDefinition Width="0.15*" />
                </Grid.ColumnDefinitions>
                <TabControl
                    x:Name="AppDetailsTabControl"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    >
                    <TabItem Header="Overwiew" />
                    <TabItem Header="System Requirements" />
                    <TabItem Header="Reviews" />
                    <TabItem Header="Overwiew" />
                </TabControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
