<Page x:Class="WindowsStoreClone.Pages.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WindowsStoreClone.Pages"
      xmlns:uc="clr-namespace:WindowsStoreClone.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Main">

    <Grid Name="MainWindowMainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="35" />
            <ColumnDefinition Width="0.6*" />
            <ColumnDefinition Width="0.4*" />
            <ColumnDefinition Width="35" />
        </Grid.ColumnDefinitions>

        <TabControl
            x:Name="MainTabControl"
            Visibility="Visible"
            Grid.Row="0" Grid.Column="1"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            ClipToBounds="True"
            >
            <TabItem Header="Home" Name="HomeTab" >
                <ScrollViewer Name="MainScrollViewer"
                              Margin="10"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              Loaded="MainScrollViewer_Loaded"
                              Opacity="0.5"
                              >
                    <!--
                    <ScrollViewer.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation From="0" To="1" Duration="0:0:0.5" Storyboard.TargetProperty="Opacity"/>

                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ScrollViewer.Triggers>
                    -->
                    <StackPanel
                        Name="MainHomeStackPanel"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Visibility="Visible"
                        Width="{Binding ElementName=MainScrollViewer, Path=ActualWidth}"
                        >
                        <uc:TopApps x:Name="TopApps"
                                    HorizontalAlignment="Left"
                                    Width="{Binding ElementName=MainTabControl, Path=ActualWidth}" 
                                    Margin="2"/>

                        <Label 
                            HorizontalAlignment="Left"
                            Margin="10,10,10,10"
                            Content="Featured Apps"
                            FontSize="40"
                            />

                        <uc:AppsViewer 
                             HorizontalAlignment="Left"
                             Width="{Binding ElementName=MainScrollViewer, Path=ActualWidth}" 
                             Margin="2" x:Name="FeaturedAppsViewer"></uc:AppsViewer>


                        <Label 
                            HorizontalAlignment="Left"
                            Margin="10,10,10,10"
                            Content="Most Popular Apps"
                            FontSize="40"
                            />

                        <uc:AppsViewer
                             HorizontalAlignment="Left"
                             Width="{Binding ElementName=MainScrollViewer, Path=ActualWidth}" 
                             Margin="2" x:Name="MostPopulatAppsViewer"></uc:AppsViewer>


                        <Label 
                            HorizontalAlignment="Left"
                            Margin="10,10,10,10"
                            Content="Top Free Apps"
                            FontSize="40"
                            />

                        <uc:AppsViewer
                             HorizontalAlignment="Left"
                             Width="{Binding ElementName=MainScrollViewer, Path=ActualWidth}" 
                             Margin="2" x:Name="TopFreeAppsViewer"></uc:AppsViewer>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem  Header="Gaming" Name="GamingTab" Loaded="GamingTab_Loaded">
                    <StackPanel>
                        <Label 
                            HorizontalAlignment="Left"
                            Margin="10,10,10,10"
                            Content="Top Free games"
                            FontSize="40"
                            />
                        <uc:AppsViewer
                           HorizontalAlignment="Left"
                           Width="{Binding ElementName=MainTabControl, Path=ActualWidth}" 
                           Margin="2" x:Name="TopFreeGamesViewer"></uc:AppsViewer>
                    </StackPanel>
            </TabItem>

            <TabItem  Header="Entertainment" Name="EntertainmentTab" >
                <StackPanel>
                    <Label 
                            HorizontalAlignment="Left"
                            Margin="10,10,10,10"
                            Content="Top Free games"
                            FontSize="40"
                            />
                    <uc:AppsViewer
                           HorizontalAlignment="Left"
                           Width="{Binding ElementName=MainTabControl, Path=ActualWidth}" 
                           Margin="2" x:Name="EntertainmentAppsViewer"></uc:AppsViewer>
                </StackPanel>
            </TabItem>

            <TabItem Header="Productivity">
                <ScrollViewer x:Name="MainProductivityScrollViewer"
                              Margin="10"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              >
                    <StackPanel Name="MainProductivityStackPanel"
                                Width="{Binding ElementName=MainProductivityScrollViewer, Path=ActualWidth}">
                        <uc:ProductiviyTopApps x:Name="ProductivityTopApps"
                                               Width="{Binding ElementName=MainHomeStackPanel, Path=ActualWidth}" />

                        <Label 
                            HorizontalAlignment="Left"
                            Margin="10,10,10,10"
                            Content="App Specials"
                            FontSize="40"
                            />
                        <uc:AppsViewer
                           HorizontalAlignment="Left"
                           Width="{Binding ElementName=MainProductivityStackPanel, Path=ActualWidth}" 
                           Margin="2" x:Name="ProductitivyAppsL1"></uc:AppsViewer>

                        <Label 
                            HorizontalAlignment="Left"
                            Margin="10,10,10,10"
                            Content="Best selling apps"
                            FontSize="40"
                            />
                        <uc:AppsViewer
                           HorizontalAlignment="Left"
                           Width="{Binding ElementName=MainProductivityStackPanel, Path=ActualWidth}" 
                           Margin="2" x:Name="ProductitivyAppsL2"></uc:AppsViewer>
                    </StackPanel>
                </ScrollViewer>
                              
            </TabItem>

            <TabItem  Header="Deals" Name="DealsTab" >
                <StackPanel>
                    <Label 
                            HorizontalAlignment="Left"
                            Margin="10,10,10,10"
                            Content="App Specials"
                            FontSize="40"
                            />
                    <uc:AppsViewer
                           HorizontalAlignment="Left"
                           Width="{Binding ElementName=MainTabControl, Path=ActualWidth}" 
                           Margin="2" x:Name="DealstAppsViewer"></uc:AppsViewer>
                </StackPanel>
            </TabItem>
        </TabControl>
        <uc:HeaderRightButtons  x:Name="rightHeaderButtons"  Grid.Column="2" Grid.ColumnSpan="1" Grid.Row="0"/>
    </Grid>
</Page>
