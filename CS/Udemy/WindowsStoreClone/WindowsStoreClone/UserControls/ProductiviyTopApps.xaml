<UserControl x:Class="WindowsStoreClone.UserControls.ProductiviyTopApps"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsStoreClone.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Name="LeftMostColumn" Width="1*" />
            <ColumnDefinition Name="LeftColumn" Width="1*" />
            <ColumnDefinition Name="RightColumn" Width="1*" />
            <ColumnDefinition x:Name="RightMostColumn" Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Image
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            Source="/Images/ProductivityAppIcons/Photoshop.png"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Stretch="Fill"
            Margin="2,2,2,2"
            MouseUp="Image_MouseUp"
            />

        <Image
          Grid.Row="0"
          Grid.Column="2"
          Grid.RowSpan="2"
          Grid.ColumnSpan="2"
          Source="/Images/ProductivityAppIcons/HotspotShield.png"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch"
          Stretch="Fill"
          Margin="2,2,2,2"
          MouseUp="Image_MouseUp"
          />

        <Image
            Grid.Row="2"
            Grid.Column="0"
            Source="/Images/ProductivityAppIcons/ACDSee.png"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Stretch="Fill"
            Margin="2,2,2,2"
            MouseUp="Image_MouseUp"
            />

        <Image
            Grid.Row="2"
            Grid.Column="1"
            Source="/Images/ProductivityAppIcons/DrawboardPDF.png"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Stretch="Fill"
            Margin="2,2,2,2"
            MouseUp="Image_MouseUp"
            />

        <Image
            Grid.Row="2"
            Grid.Column="2"
            Source="/Images/ProductivityAppIcons/PicsArt.png"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Stretch="Fill"
            Margin="2,2,2,2"
            MouseUp="Image_MouseUp"
            />

        <Image
            Grid.Row="2"
            Grid.Column="3"
            Source="/Images/ProductivityAppIcons/YourPhone.png"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Stretch="Fill"
            Margin="2,2,2,2"
            MouseUp="Image_MouseUp"
            />

    </Grid>
</UserControl>
