<UserControl x:Class="WindowsStoreClone.UserControls.AppDetailsTabContent.Overview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsStoreClone.UserControls.AppDetailsTabContent"
             xmlns:uc="clr-namespace:WindowsStoreClone.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Name="OverviewUserControl"
             >
    <StackPanel
        Orientation="Vertical"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Visibility="Visible"
        Background="#2e2e2e"
        Width="{Binding ElementName=OverviewUserControl, Path=ActualWidth}"
        >
        <Label FontSize="25" Foreground="White">Avaiable on</Label>
        <TextBlock FontFamily="12" Margin="5,5,15,5" Foreground="White" TextAlignment="Left" TextWrapping="Wrap" Text="PC" />

        <Label FontSize="25" Foreground="White">Description</Label>
        <TextBlock FontFamily="12" Margin="5,5,15,5" Foreground="White" TextAlignment="Left" TextWrapping="Wrap">
            Lorem impus dolor sit amet,., consecteur, adipiscing elit, se do euson tepo ,incitud ut labre ewt dolor , 
            manfg aliqua, Ut enim ad minim veniam, quia nonstrud exercitation ullaca labirs nisi ut qaliquirt easea sd asda  as commo consequat.
        </TextBlock>
        <Label FontSize="25" Foreground="White">People also like</Label>
        <uc:AppsViewer  x:Name="AppViewerInsideOverviewTab"/>

    </StackPanel>
</UserControl>
