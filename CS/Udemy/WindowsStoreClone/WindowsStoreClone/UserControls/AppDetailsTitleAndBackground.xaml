<UserControl x:Class="WindowsStoreClone.UserControls.AppDetailsTitleAndBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsStoreClone.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="1200">
    <Grid Name="AppViewAndBackgroundGrid"
          Height="580">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>

        <Image Name="BackgroundImage"
               Grid.Row="0"
               Grid.Column="0"
               Grid.ColumnSpan="3"
               Grid.RowSpan="2"
               Source="/Images/AppDetailIcons/FieldBackground.jpg"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Stretch="Fill"
               />
        <Button 
            Name="BackButton"
            Grid.Column="0"
            Width="35"
            Height="35"
            Content="&lt;"
            Click="BackButton_Click"   
            Margin="5,5,5,5"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            />

        <Grid Grid.Row="1" Grid.Column="1"
              Name="AppWideView"
              Background="#2e2e2e"
              Margin="15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.18*" />
                <ColumnDefinition Width="0.6*" />
                <ColumnDefinition Width="0.22*" />
            </Grid.ColumnDefinitions>

            <Image 
                Name="AppImage"
                Grid.Row="0"
                Grid.Column="0"
                Source="/Images/AppDetailIcons/01-tea.png"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Stretch="Uniform"
                Margin="15"
                />

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10" Orientation="Vertical">
                <Label Name="AppNameLabel" FontSize="25" Foreground="White">Tea App</Label>
                <StackPanel Orientation="Horizontal">
                    <Label FontSize="12" Foreground="#009cfa">Tea Entertainment</Label>
                    <Label FontSize="12" Foreground="#009cfa">Action Adventure</Label>
                    <Label FontSize="12" Foreground="#009cfa">Tea</Label>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label FontSize="12" Foreground="white">Official Club</Label>
                    <Label FontSize="12" Foreground="white">Share</Label>
                </StackPanel>
                <TextBlock  Margin="6,0,0,0" FontSize="12" Foreground="white"  TextWrapping="WrapWithOverflow">lorem ipsum dolor sit ament, consecutetur adipiscin elin. sed do
                    eiusom tempor incidunt ut labore ed dolort manta aliqua. Au enim 
                    ad minim ceniam, quia nonstyrud exarcitation ullamco labrosi nisi ut
                    aliquip[ ax az commodo consequat.</TextBlock>

            </StackPanel>
            <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="2" Margin="15">
                <Label FontSize="18" Foreground="Gray">Free+</Label>
                <Button Background="#009cfa" Foreground="White">Get</Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
