<UserControl x:Class="WindowsStoreClone.UserControls.TopApps"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsStoreClone.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.25*" />
            <ColumnDefinition Width="0.25*" />
            <ColumnDefinition Width="0.25*" />
            <ColumnDefinition Width="0.25*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.33*" />
            <RowDefinition Height="0.33*" />
            <RowDefinition Height="0.33*" />
        </Grid.RowDefinitions>

        <Image 
            Name="TopImage"
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="2"
            Grid.ColumnSpan="3"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Stretch="Fill"
            Source="/Images/TopAppIcons/81-tropical.png"
            Margin="2,2,2,2"
            MouseUp="Image_MouseUp"
            />
        <Image
            Name="MiddleImage"
            Grid.Row="0"
            Grid.Column="3"
            Source="/Images/TopAppIcons/82-circus fun.png"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Stretch="Fill"
            Margin="2,2,2,2"
            MouseUp="Image_MouseUp"
            />

        <Image
            Name="BottomImage"
            Grid.Row="1"
            Grid.Column="3"
            Source="/Images/TopAppIcons/83-Race extreme.png"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Stretch="Fill"
            Margin="2,2,2,2"
            MouseUp="Image_MouseUp"
            />

        <Image
            Grid.Row="2"
            Grid.Column="3"
            Source="/Images/TopAppIcons/84-chat message.png"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Stretch="Fill"
            Margin="2,2,2,2"
            MouseUp="Image_MouseUp"
            
            />
        <Image
            Grid.Row="2"
            Grid.Column="2"
            Source="/Images/TopAppIcons/85-Night castle.png"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Stretch="Fill"
            Margin="2,2,2,2"
            MouseUp="Image_MouseUp"
            
            />
        <Grid  Name="BottomGrid"  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Button Name="TopAppsButton" Grid.Row="0" Grid.Column="0"  Content="Top Apps" Margin="2,2,2,2" FontSize="20" Click="TopAppsButton_Click"/>
            <Button Name="FeaturedButton" Grid.Row="0" Grid.Column="1"  Content="Featured" Margin="2,2,2,2" FontSize="20"/>
            <Button Name="TopGamesButton" Grid.Row="1" Grid.Column="0"  Content="Top Games" Margin="2,2,2,2" FontSize="20"/>
            <Button Name="CollectionsButton" Grid.Row="1" Grid.Column="1"  Content="Collections" Margin="2,2,2,2" FontSize="20"/>
        </Grid>

        <Canvas Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="4" Grid.RowSpan="3" Opacity="0.4" Background="#2e2e2e" IsHitTestVisible="False" />
        <Label Name="AppNameLabelTop" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="2" FontSize="25" FontWeight="DemiBold" Foreground="White" VerticalAlignment="Bottom" HorizontalContentAlignment="Center">Tropical</Label>
        <Label Name="AppNameLabelTop1" Grid.Column="3" Grid.Row="0" FontSize="25" FontWeight="DemiBold" Foreground="White" VerticalAlignment="Bottom" HorizontalContentAlignment="Center">Circus fun</Label>
        <Label Name="AppNameLabelTop2" Grid.Column="3" Grid.Row="1" FontSize="25" FontWeight="DemiBold" Foreground="White" VerticalAlignment="Bottom" HorizontalContentAlignment="Center">Race Xtreme</Label>
        <Label Name="AppNameLabelTop3" Grid.Column="3" Grid.Row="2" FontSize="25" FontWeight="DemiBold" Foreground="White" VerticalAlignment="Bottom" HorizontalContentAlignment="Center">Chat Message</Label>
        <Label Name="AppNameLabelTop4" Grid.Column="2" Grid.Row="2" FontSize="25" FontWeight="DemiBold" Foreground="White" VerticalAlignment="Bottom" HorizontalContentAlignment="Center"> Night Castle</Label>

    </Grid>
</UserControl>
