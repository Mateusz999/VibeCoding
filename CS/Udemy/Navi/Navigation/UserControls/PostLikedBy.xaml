<UserControl x:Class="Navigation.PostLikedBy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Navigation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Orientation="Horizontal" Margin="3,0,0,0">
        <TextBlock>Liked by </TextBlock>
        <TextBlock Name="CloseFriend1" Margin="3,0,0,0" Text="Gabriel, " FontWeight="Bold" />
        <TextBlock Name="CloseFriend2" Margin="3,0,0,0" Text="Marcin" FontWeight="Bold" />
        <TextBlock Name="Others" Margin="3,0,0,0" Text="and 45 others"  />
    </StackPanel>
</UserControl>
