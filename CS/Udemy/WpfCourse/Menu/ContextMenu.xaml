<Window x:Class="WpfCourse.Menu.ContextMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfCourse.Menu"
        mc:Ignorable="d"
        Title="ContextMenu" Height="450" Width="800">
    <StackPanel>

        <TextBox x:Name="mytb" Height="200">
            <TextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Checked="miBold_Checked" Unchecked="miBold_Unchecked"  IsCheckable="True" Name="miBold"  Header="Bold" Click="MenuItem_Click"></MenuItem>
                    <MenuItem Checked="miItalic_Checked" Unchecked="miItalic_Unchecked" IsCheckable="True" Name="miItalic"  Header="Italic" Click="miItalic_Click"></MenuItem>
                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>
        <Button x:Name="myButton">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Change Text" Click="MenuItem_Click_2">
                        
                    </MenuItem>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>

    </StackPanel>

</Window>
