<Window x:Class="WpfCourse.CaldendarControlDemo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfCourse"
        mc:Ignorable="d"
        Title="CaldendarControlDemo" Height="400" Width="300">
    <StackPanel>
        <Viewbox Stretch="Uniform">
            <Calendar
                
                SelectedDatesChanged="myCalendar_SelectedDatesChanged_1"
                x:Name="myCalendar"
                >
                <Calendar.BlackoutDates>
                    <CalendarDateRange Start="2026-02-16" End="2026-02-21" />
                </Calendar.BlackoutDates>
            </Calendar>
        </Viewbox>
        <TextBlock
            x:Name="myTextblock" >
            Data: 
        </TextBlock>
    </StackPanel>
</Window>
