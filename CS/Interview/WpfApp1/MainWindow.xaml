<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <TextBlock 
            Grid.Row="0"
            Height="50"
            Width="100"
            Text="Interview Task"
            TextAlignment="Center"
            VerticalAlignment="Center"
            />

        <TextBox
            x:Name="txtInputValue"
            Height="50"
            Width="150"
            Grid.Row="1"
            FontSize="30"
            PreviewTextInput="txtInputValue_PreviewTextInput"
            TextChanged="txtInputValue_TextChanged"
            GotFocus="txtInputValue_GotFocus"
            PreviewMouseDown="txtInputValue_PreviewMouseDown"
            DataObject.Pasting="txtInputValue_Pasting"
            />

        <Button 
            x:Name="factorialBtn"
            Grid.Row="2"
            Width="100"
            Height="50"
            Content="x!"
            FontSize="25"
            Click="factorialBtn_Click"
            IsEnabled="False"
            />

        <TextBox
            x:Name="txtResult"
            Grid.Row="3"
            Width="700"
            Height="100"
            IsTabStop="False"
            IsReadOnly="True"
            />

    </Grid>
</Window>
