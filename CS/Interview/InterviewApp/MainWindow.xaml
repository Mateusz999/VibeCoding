<Window x:Class="InterviewApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InterviewApp"
        mc:Ignorable="d"
        Title="Interview Task by Mateusz Biernat" Height="450" Width="800">
    <Grid>
     

        <Grid.RowDefinitions>
            <RowDefinition Height="75" />
            <RowDefinition Height="100" />
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock 
            Text="Interview App" 
            Grid.Row="0" 
            FontWeight="Bold"
            FontSize="25"
            TextAlignment="Center"
            Margin="10"/>

        <Border
            CornerRadius="8" 
            BorderBrush="black" 
            BorderThickness="1" 
            Height="45"
            Width="250"
            Padding="5"
            Grid.Row="1">
            <TextBox
                x:Name="txtInputValue"
                FontSize="27"
                BorderThickness="0" 
                Height="45"
                Width="250"
                TextChanged="txtInputValue_TextChanged"
                PreviewTextInput="txtInputValue_PreviewTextInput"
                DataObject.Pasting="txtInputValue_Pasting"
                PreviewKeyDown="txtInputValue_PreviewKeyDown"
                PreviewMouseDown="txtInputValue_PreviewMouseDown"
                GotFocus="txtInputValue_GotFocus"
                />
        </Border>
            <Button 
                x:Name="btnFactorial"
                Grid.Row="2"
                BorderThickness="0" 
                Height="45"
                Width="250"
                FontSize="25"
                IsEnabled="False"
                Click="btnFactorial_Click"
                Content="x!"/>

        <Border
            CornerRadius="8"
            BorderBrush="Black"
            BorderThickness="1"
            Height="100"
            Padding="0"
            Width="750"
            Grid.Row="3"
            >
        <TextBox
            TextWrapping="Wrap"
            FontSize="14"
            TextAlignment="Center"
            VerticalAlignment="Center"
            x:Name="txtResult"
            BorderThickness="0"
            IsReadOnly="true"
            IsTabStop="False"
            />
        </Border>


    </Grid>
</Window>
